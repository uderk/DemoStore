{
  "name": "demostore",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:build": "eslint . --ignore-pattern tests/e2eTests --max-warnings=0",
    "lint:e2e": "eslint tests/e2eTests --max-warnings=0",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "pretty:check": "prettier --check . --ignore-path .gitignore --ignore-unknown",
    "pretty:fix": "prettier --write . --ignore-path .gitignore --ignore-unknown",
    "pretty:check:build": "prettier --check . --ignore-path .gitignore --ignore-unknown '!tests/e2eTests/**'",
    "pretty:fix:build": "prettier --write . --ignore-path .gitignore --ignore-unknown '!tests/e2eTests/**'",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPattern=unitTests",
    "test:component": "jest --testPathPattern=componentTests",
    "test:e2e": "playwright test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": "24"
  },
  "type": "module",
  "dependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "lucide-react": "^1.7.0",
    "next": "^16.2.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.27",
    "eslint": "^10.3.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.0.0"
  }
}
